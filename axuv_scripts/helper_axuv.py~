    def symmetric_extraction(self, cm_coor, xmesh, start, stop):
        from scipy.ndimage import gaussian_filter
        from scipy.signal import find_peaks
        
        xst = -36
        xed =  36
        #xmesh = 611
        
        Ncm = len(cm_coor)
        
        decter_x_list        = np.zeros([xmesh, Ncm])
        smoothed_signal_list = np.zeros([xmesh, Ncm])
        y_new_list           = np.zeros([xmesh, Ncm])
        y_rawlist = {}
        x_rawlist = {}
        real_coor_aftermean = (self.philist - cm_coor.reshape(Ncm,1))
        real_detector_cm_aftermean = (np.tan(real_coor_aftermean)*self.slit_ref_r).T
        
        decter_x = np.linspace(xst, xed, xmesh)
        y_all    = self.axuvData_cal[:, start:stop]-np.min(self.axuvData_cal[:, start:stop], axis = 0)*0.2
        
        for i in range(Ncm):
            
            y_original = y_all.copy()[::-1, i]
            x_original = real_detector_cm_aftermean[::-1, i]
            
