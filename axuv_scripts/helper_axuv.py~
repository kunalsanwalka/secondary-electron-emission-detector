class axuvpy:
    def __init__(self, shotnum, nod=20, slit_ref_r=38, 
                 Rwall=36.2, Rflange=15.94*2.54, recal=-0.02902686628404144):
        self.ref_doid_num = 11
        self.nod = nod  # Number of diodes
        self.shotnum = shotnum
        self.slit_ref_r = slit_ref_r
        self.Rwall = Rwall
        self.Rflange = Rflange
        self.recal_diode   = recal # rad offset from diode 11
        #self.recal_diode   = -0.12200925
        self.AssumR_Plasma = slit_ref_r

        # rr = np.sqrt(x_axuv**2+y_axuv**2)
        # tr = np.arctan(y_axuv/x_axuv)
        # self.x_axuv = rr*np.cos(rr)
        # self.y_axuv = rr*np.sin(rr)

        # Automatically assign and initialize these when the class is instantiated
        self.procTree  = mds.Tree('axuv', shotnum)
        self.Phi_slit  = self.procTree.getNode('DIODEARRAY1.PHI_SLIT').getData().data()
        self.time      = self.procTree.getNode('DIODEARRAY1.CH_01.PHOTOCURRENT').getData().dim_of().data()
        
        # Initialize the arrays
        self.x_axuv = -self.slit_ref_r*np.cos(self.Phi_slit)
        self.y_axuv =  self.slit_ref_r*np.sin(self.Phi_slit)
        self.axuvData  = np.zeros((self.nod, len(self.time)))
        self.Rarray    = np.zeros((self.nod))
        self.Rs        = np.zeros_like(self.Rarray)
        self.Phis      = np.zeros_like(self.Rs)
        self.philist   = np.zeros_like(self.Phis) 
        self.view_ang  = np.zeros_like(self.philist) 
        self.dnum      = np.zeros_like(self.view_ang) 
        self.S_eff     = np.zeros_like(self.dnum)
        self.ref_real_axuv =  np.pi+self.Phi_slit #rad
        
        #np.abs(axuv.slit_ref_r - axuv.Rs*100)
        # Call method to fill the arrays (optional)
        self.populate_arrays()
        self.philist = self.philist-self.recal_diode
        self.dnum         = self.dnum.astype(int)
        self.axuvData_cal = self.axuvData*(self.Rarray.reshape(len(self.Rarray),1))
        #########no - signal#########
        self.axuvData_cal[self.axuvData_cal < 0] = 0
        
        self.ref_doid_inx  = np.where(self.dnum==self.ref_doid_num)[0]
        

        
        Rwalllist = np.full(1000, Rwall) 
        theta_vals = np.linspace(0, 2 * np.pi, len(Rwalllist))
        wham_x = Rwalllist*np.cos(theta_vals)
        wham_y = Rwalllist*np.sin(theta_vals)
        
        self.wham_x_slit = wham_x - self.x_axuv
        self.wham_y_slit = wham_y - self.y_axuv
        
        self.WHAM_R     = np.sqrt(self.wham_x_slit**2 + self.wham_y_slit**2)
        self.WHAM_theta = np.arctan2(self.wham_y_slit, self.wham_x_slit)
        wham_y = self.WHAM_R*np.sin(self.WHAM_theta)
        wham_x = self.WHAM_R*np.cos(self.WHAM_theta)
        self.min_wham_y = np.min(wham_y)
        self.min_wham_x = np.min(wham_x)
        self.max_wham_y = np.max(wham_y)
        self.max_wham_x = np.max(wham_x)
        self.d_loc = np.abs(self.Rs*100-self.slit_ref_r)
        self.ass_impact = np.tan(self.philist- self.ref_real_axuv)*self.slit_ref_r
        self.philist_ref = self.philist-self.ref_real_axuv

    def populate_arrays(self):
        # Collecting data from the tree and populating the arrays
        #for idx in range(self.nod):
        try:
            for idx in range(self.nod):
                self.philist[idx]     = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.LOS_DEG').getData().data()/180*np.pi+(self.ref_real_axuv)
                #print(self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.LOS_DEG').getData().data(), self.philist[idx]*180/np.pi)
                self.view_ang[idx]    = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.AOV_DEG').getData().data()
                self.S_eff[idx]       = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.V_PEAK').getData().data()
                self.dnum[idx]        = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.DIODE_NUM').getData().data()
   
    
                self.axuvData[idx, :] = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.PHOTOCURRENT').getData().data()
                self.Rarray[idx]      = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.RESISTOR').getData().data()
                self.Rs[idx]          = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.R').getData().data()
                self.Phis[idx]        = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.PHI').getData().data()
                
            self.S_eff = self.S_eff/max(self.S_eff)
            self.axuvData = self.axuvData/(self.S_eff.reshape(len(self.S_eff),1))
            if self.shotnum <= 241218032:
                self.dnum[5] = 15        
        
        except Exception as e:
            #self.recal_diode = -0.09724126727115814
            self.recal_diode = 0
            print(f"Error processing serial number {self.shotnum}: {e}")
            for idx in range(self.nod):
                self.axuvData[idx, :] = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.PHOTOCURRENT').getData().data()
                self.Rarray[idx]      = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.RESISTOR').getData().data()
                self.Rs[idx]          = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.R').getData().data()
                self.Phis[idx]        = self.procTree.getNode(f'DIODEARRAY1.CH_{idx+1:02d}.PHI').getData().data()

            xss = self.Rs * np.cos(self.Phis)
            yss = self.Rs * np.sin(self.Phis)
            ms = (self.slit_ref_r / 100 * np.sin(self.Phi_slit) - yss) / (self.slit_ref_r / 100 * np.cos(self.Phi_slit) - xss)
            self.philist       = np.arctan2(ms, 1)  # Storing the result as a class attribute
            self.mean_los = (self.philist[:-1]+self.philist[1:])/2
            self.view_ang = np.diff(self.mean_los)
            self.view_ang = np.hstack([[(self.mean_los[0]-self.philist[0])*2], self.view_ang, [(self.philist[-1]-self.mean_los[-1])*2]])
            self.view_ang = np.abs(self.view_ang)             
            self.dnum     = np.linspace(1, self.nod, self.nod).astype(int)[::-1]
            
    def rmin_max(self, thetap, xs, ys, Rw):
    
        Rg  = ys*np.sin(thetap) + xs*np.cos(thetap)
        Rsl = np.sqrt(ys**2+xs**2) 
        Rn1 = 2*Rg+np.sqrt(4*Rg**2-4*(Rsl**2-Rw**2))
        Rn2 = 2*Rg-np.sqrt(4*Rg**2-4*(Rsl**2-Rw**2))
        return Rn1/2, Rn2/2

    def corners(self, diode_list_one):
        from scipy.signal import find_peaks

        axuv_all_f = diode_list_one
        # peaks, _ = find_peaks(np.diff(axuv_all_f), height=0.1, distance = len(axuv_all_f))
        # lpeaks, _ = find_peaks(-np.diff(axuv_all_f)[::-1], height=0.1, distance = len(axuv_all_f))
        # lpeaks = len(axuv_all_f)- lpeaks
        mi_peak  = np.argmax(axuv_all_f)
        peaks   = [mi_peak]
        lpeaks  = [mi_peak]
        con_rais = np.argmax(axuv_all_f[peaks[0]]/peaks[0]* np.arange(0, peaks[0])- axuv_all_f[:peaks[0]])

        fall_m = np.diff((axuv_all_f[[lpeaks[0], -1]])/(len(axuv_all_f)-lpeaks[0]))[0] 
        fall_c = axuv_all_f[-1]
        con_fall = np.argmax( -(axuv_all_f[lpeaks[0]:] -fall_m*(-np.arange(0,len(axuv_all_f)-lpeaks[0])[::-1])-fall_c)  )+lpeaks[0]
        
        
        corners = np.array([con_rais,con_fall])

        return corners

